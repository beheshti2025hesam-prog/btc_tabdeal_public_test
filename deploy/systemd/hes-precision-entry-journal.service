[Unit]
Description=HES Gate.io 1m Precision Paper Journal (read-only market data, paper-only outcomes)
After=network-online.target hes-global-market-data-gateio-1m.service hes-strategy-paper-evaluator.service
Wants=network-online.target hes-global-market-data-gateio-1m.service hes-strategy-paper-evaluator.service
StartLimitIntervalSec=1h
StartLimitBurst=2

[Service]
Type=simple
User=sentinelx
Group=sentinelx
WorkingDirectory=/opt/hes-trade-agent/current
Environment=PYTHONPATH=/opt/hes-trade-agent/current
Environment=PYTHONUNBUFFERED=1
Environment=HES_DATA_ROOT=/opt/hes-trade-agent
Environment=HES_STRATEGY_V2_REPORT_PATH=/opt/hes-trade-agent/data/forward/strategy_policy_v2_eval_report.json
Environment=HES_TRADE_JOURNAL_PATH=/opt/hes-trade-agent/data/forward/trade_journal_v2.jsonl
ExecStart=/opt/hes-trade-agent/.venv/bin/python -u /opt/hes-trade-agent/current/scripts/run_precision_entry_journal_v1.py
# Recovery attempts are governed by the audited five-minute HES monitor.
# Do not let systemd bypass its per-service hourly budget or health preflight.
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hes-trade-agent/data/forward /opt/hes-trade-agent/logs
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
