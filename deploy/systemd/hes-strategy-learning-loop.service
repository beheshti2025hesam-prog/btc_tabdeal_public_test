[Unit]
Description=HES Evidence-Driven Strategy Learning Loop
After=network-online.target hes-strategy-paper-evaluator.service
Wants=network-online.target
ConditionPathExists=/opt/hes-trade-agent/current/scripts/run_strategy_learning_loop_v1.py
ConditionPathExists=/opt/hes-trade-agent/data/forward/trade_journal_v2.jsonl

[Service]
Type=simple
User=sentinelx
Group=sentinelx
WorkingDirectory=/opt/hes-trade-agent/current
Environment=HES_DATA_ROOT=/opt/hes-trade-agent
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hes-trade-agent/.venv/bin/python -u /opt/hes-trade-agent/current/scripts/run_strategy_learning_loop_v1.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
ReadWritePaths=/opt/hes-trade-agent/data/forward /opt/hes-trade-agent/logs

[Install]
WantedBy=multi-user.target
