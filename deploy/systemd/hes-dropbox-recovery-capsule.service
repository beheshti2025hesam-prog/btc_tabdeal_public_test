[Unit]
Description=HES encrypted Dropbox recovery capsule build, publish and verified rotation
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/.config/hes-backup/passphrase
ConditionPathExists=/root/.config/rclone/rclone.conf

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/hes-dropbox-recovery-capsule-cycle
Nice=10
IOSchedulingClass=idle
CPUWeight=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/backups/hes-trade-agent/offsite-staging /var/log/hes-trade-agent /run/lock
