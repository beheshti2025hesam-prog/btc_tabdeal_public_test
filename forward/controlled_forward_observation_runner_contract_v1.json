{
  "schema": "hes_controlled_forward_observation_runner_v1",
  "status": "ACTIVE_FAIL_CLOSED",
  "purpose": "Prevent live observation from starting until exact-feed sequence semantics, source completeness, source ordering, and evidence provenance are independently reviewed and pinned",
  "sequence_contract_verified_default": false,
  "sequence_contract_evidence_ref_required": true,
  "block_reason": "UPSTREAM_SEQUENCE_CONTRACT_UNVERIFIED",
  "block_before_network": true,
  "block_before_session_write": true,
  "execution_enabled": false,
  "historical_inputs_allowed": false,
  "future_outcomes_allowed": false,
  "collector_autostart": false,
  "fail_closed": true,
  "source_completeness_verified_default": false,
  "source_completeness_evidence_ref_required": true,
  "source_completeness_block_reason": "SOURCE_COMPLETENESS_UNVERIFIED",
  "source_ordering_verified_default": false,
  "source_ordering_evidence_ref_required": true,
  "source_ordering_block_reason": "SOURCE_ORDERING_UNVERIFIED",
  "production_observation_authorized": false,
  "production_blocker": "SOURCE_EVIDENCE_REGISTRY_PIN_UNSET_AND_REVIEW_PROVENANCE_UNVERIFIABLE",
  "source_evidence_registry": {
    "schema": "hes_source_evidence_registry_v1",
    "path": "evidence/source_evidence_registry_v1.json",
    "pin_constant": "forward.source_evidence_registry_v1.PINNED_SOURCE_EVIDENCE_REGISTRY_SHA256",
    "pin_default": "UNSET",
    "caller_supplied_boolean_or_reference_is_proof": false,
    "verified_before_network": true,
    "verified_before_session_write": true,
    "required_evidence_types": [
      "sequence_contract",
      "source_completeness",
      "source_ordering"
    ],
    "required_scope": "tabdeal-futures:BTC_USDT",
    "artifact_sha256_required": true,
    "pair_audit_record_required": true,
    "failure_mode": "BLOCKED",
    "production_observation_authorized": false
  },
  "sequence_semantics": {
    "field": "trade.sequence",
    "role": "INFORMATIONAL_METADATA_ONLY",
    "required": false,
    "used_for_identity": false,
    "used_for_deduplication": false,
    "used_for_ordering": false,
    "used_for_gap_detection": false,
    "repeated_values": "PRESERVE_EVERY_EVENT",
    "numeric_jumps_or_decreases": "NO_INFERENCE"
  },
  "source_completeness_and_ordering_required": true,
  "raw_trade_payload_persistence_required_before_any_future_production_capture": true
}
